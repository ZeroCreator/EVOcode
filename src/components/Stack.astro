---
const stacks = [
  {
    title: 'Парсинг и сбор данных',
    text: 'Любые сайты, защита, обход блокировок, история цен, интеграция с 1С.'
  },
  {
    title: 'Микросервисы и интеграции',
    text: 'API, связка 1С и внешних сервисов, маркетплейсы, B2B-ценообразование.'
  },
  {
    title: 'Алгоритмы и IoT',
    text: 'Управление конвейерами, снижение брака, обработка потоков данных в реальном времени.'
  },
  {
    title: 'BI и дашборды',
    text: 'Агрегация данных, визуализация KPI, быстрые решения на основе фактов.'
  },
  {
    title: 'DevOps и Linux',
    text: 'Серверы, виртуализация, почтовики, CI/CD, мониторинг, резервное копирование.'
  },
  {
    title: 'Сопровождение',
    text: 'Поддержка работоспособности инфраструктуры клиента, доработки и масштабирование.'
  }
];
---

<section id="stack" class="section stack">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__tag">Компетенции</span>
      <h2 class="section__title">Что у нас в арсенале</h2>
    </div>
    <div class="stack__grid">
      {stacks.map((item) => (
        <div class="stack-card reveal">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
