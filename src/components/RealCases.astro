---
const cases = [
  'Внутренний service desk для Lanta Service',
  'Поддержка интернет-магазина korallmicro.ru',
  'Мониторинг 1 000 000+ цен конкурентов для ГК КМ',
  'Мониторинг динамики цен на маркетплейсах для giper.fm',
  'Алгоритмы оптимизации производственных линий для Антантис-Пака',
  'ИИ-анализ телефонных звонков в ТИМ-73',
  'Генерация описаний карточек товаров в ГК КМ',
  'Миграция на новый helpdesk для авиакомпании Азимут',
  'Сопровождение инфраструктуры ТИМ-73 (почта, виртуальные машины, внутренние платформы)'
];
---

<section id="real-cases" class="section real-cases">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__tag">Клиенты</span>
      <h2 class="section__title">Реальные кейсы внешних клиентов</h2>
      <p class="section__lead">Задачи, которые мы уже решили лично.</p>
    </div>

    <div class="real-cases__grid">
      {cases.map((item, index) => (
        <div class="real-case-card reveal">
          <span class="real-case-card__num">{String(index + 1).padStart(2, '0')}</span>
          <p>{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>
