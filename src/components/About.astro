---
const stats = [
  { num: '5+', label: 'лет опыта' },
  { num: '10+', label: 'крупных клиентов' },
  { num: '30+', label: 'отдельных проектов' },
  { num: '2', label: 'реестровых продукта' }
];

const directions = [
  'WEB разработка',
  'DevOps',
  'Всё, что связано с ИИ',
  'Системное администрирование'
];
---

<section id="about" class="section about">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__tag">О нас</span>
      <h2 class="section__title">Инженерная команда для сложных задач</h2>
      <p class="section__lead">
        Решаем то, что не берут типовые подрядчики: парсинг, интеграции, алгоритмы, DevOps и ИИ под ключ.
      </p>
    </div>

    <div class="about__stats">
      {stats.map((item) => (
        <div class="stat-card reveal">
          <span class="stat-card__num">{item.num}</span>
          <span class="stat-card__label">{item.label}</span>
        </div>
      ))}
    </div>

    <div class="about__directions reveal">
      <h3>Наши направления</h3>
      <div class="directions__list">
        {directions.map((dir) => (
          <span class="direction-tag">{dir}</span>
        ))}
      </div>
    </div>
  </div>
</section>
