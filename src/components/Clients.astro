---
const clients = [
  {
    num: '01',
    title: 'Производственные компании',
    text: 'Которые хотят снизить брак и оптимизировать процессы.'
  },
  {
    num: '02',
    title: 'Ритейл и дистрибьюторы',
    text: 'Которым нужны данные конкурентов и автоматизация ценообразования.'
  },
  {
    num: '03',
    title: 'Компании с B2B-системами',
    text: 'Где цены зависят от поставщиков и рыночной ситуации.'
  },
  {
    num: '04',
    title: 'Бизнесы, которые выросли из Excel',
    text: 'И хотят видеть дашборды в реальном времени.'
  }
];
---

<section id="clients" class="section clients">
  <div class="container">
    <div class="section__head reveal">
      <span class="section__tag">Клиенты</span>
      <h2 class="section__title">Кому это подходит</h2>
    </div>
    <div class="clients__grid">
      {clients.map((item) => (
        <div class="client-card reveal">
          <span class="client-card__num">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
